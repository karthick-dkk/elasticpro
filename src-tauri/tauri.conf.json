{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ElasticPro",
  "identifier": "io.elasticpro.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ElasticPro",
        "width": 1380,
        "height": 900,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "publisher": "Karthick Dkk",
    "copyright": "Copyright (c) 2026 Karthick Dkk. MIT licensed.",
    "shortDescription": "Multi-cluster Elasticsearch dashboard",
    "longDescription": "Health, disk, indices, snapshots and SLM for many Elasticsearch clusters on one screen - including clusters reachable only through an SSH jump host. Read-only towards Elasticsearch by default.",
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
