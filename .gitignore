# Rust
/target/
**/*.rs.bk

# Local build output and data left by the desktop app (removed in 0.3.54)
/dist/
/src-tauri/
/data/
/WebView2Runtime/

# Operator config — may hold credentials. Never commit.
config_cluster.json
clusters.yaml
!/lab/clusters.yaml
!/lab/clusters-nocred.yaml
!/ui/clusters.example.yaml
pins.json

# Editors / tooling
/.serena/
.DS_Store
.idea/
.vscode/
.gstack/
node_modules/

# Deploy secrets written by the setup scripts (Vault init, tokens, TLS keys). Never commit.
/deploy/secrets/
/deploy/vault/secrets/
/deploy/zabbix/stack/secrets/
/deploy/zabbix/stack/tls/
/deploy/zabbix/module/elasticpro/config.php

# Copied in from the zabbix-host-inventory repo at install time; not ours to track.
deploy/zabbix/module/host_inventory/

# Release artifacts belong in GitHub Releases, not the tree: a binary tracked beside its
# own source drifts behind it. These are what the old desktop cross-build dropped at the
# repo root, and previous-releases/ is where it moved the build it replaced.
/*.exe
/WebView2Loader.dll
/SHA256SUMS.txt
/previous-releases/
