# Port nginx listens on. 443 unless something else already has it.
LISTEN=443
# Directory holding the jump-host private keys the config refers to (mounted read-only).
SSH_KEYS_DIR=./ssh

# Fleet at Scale (100-300 clusters) — the core's own poller/cache knobs. Sensible for
# most fleets; see README.md ("Scaling to a large fleet") before changing them.
#
# How often a reachable cluster's health/root is polled in the background, seconds. (Only the
# Automatic, Background and Hybrid request policies poll; the shipped Client basis fetches when a page asks.)
# ELASTICPRO_POLL_HEALTH_SECS=180
# How many background ES calls the core runs at once, across every cluster. Unset: 16 for
# Automatic/Background, 4 under the shipped Client basis. Set, it wins over both.
# ELASTICPRO_POLL_CONCURRENCY=16
# The in-memory fleet cache's size budget, megabytes. Unset: a quarter of the core's memory
# limit (512 at 2g), logged at start as "memory budget".
# ELASTICPRO_CACHE_MB=512

# The core container's memory cap. 2g by default; on a 4 GB host that also runs the Zabbix
# stack and Elasticsearch, 512m (the cache sizes itself from it) — see zabbix/README.md.
# ELASTICPRO_MEM_LIMIT=2g

# The report worker (docs/WORKER.md): the same image as the core in role `worker`, running the
# daily volume collection, the report queue and schedules, the hosts collection, report builds
# and mail. Its own memory and CPU cap, so a report can never slow the monitoring down. The role
# itself is set in docker-compose.yml (core: ELASTICPRO_ROLE=core, worker: ELASTICPRO_ROLE=worker);
# a compose file without it runs everything in the core (role all), as before 0.3.54.
# ELASTICPRO_WORKER_MEM_LIMIT=1g
# ELASTICPRO_WORKER_CPUS=1.0
# The worker's own request gate: requests at once overall, per cluster and per jump host. All of
# them Background; the adaptive controller decides how many of a cluster's slots a report uses.
# ELASTICPRO_WORKER_GATE_CONCURRENCY=16
# ELASTICPRO_WORKER_GATE_PER_CLUSTER=4
# ELASTICPRO_WORKER_GATE_PER_JUMP_HOST=4
