# Port nginx listens on. 443 unless something else already has it.
LISTEN=443
# Directory holding the jump-host private keys the config refers to (mounted read-only).
SSH_KEYS_DIR=./ssh

# Fleet at Scale (100-300 clusters) — the core's own poller/cache knobs. Sensible for
# most fleets; see README.md ("Scaling to a large fleet") before changing them.
#
# How often a reachable cluster's health/root is polled in the background, seconds.
# ELASTICPRO_POLL_HEALTH_SECS=180
# How many background ES calls the core runs at once, across every cluster.
# ELASTICPRO_POLL_CONCURRENCY=16
# The in-memory on-demand cache's size budget, megabytes (LRU by bytes).
# ELASTICPRO_CACHE_MB=256

# The core container's memory cap. 1g by default; on a 4 GB host that also runs the Zabbix
# stack and Elasticsearch, 512m with ELASTICPRO_CACHE_MB=64 — see zabbix/README.md.
# ELASTICPRO_MEM_LIMIT=1g
