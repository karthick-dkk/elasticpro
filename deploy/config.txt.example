# ElasticPro settings — one file for the whole hosted install.
#
# Copy to deploy/config.txt (deploy.sh and install.sh do this for you when it is missing),
# edit, then apply:
#
#     deploy/deploy.sh --apply-config
#
# Rules:
#   * KEY=VALUE, one per line. Lines starting with # are comments. No quotes needed.
#   * A key left empty (or commented out) is not managed here: the default, or the Config
#     page, decides. A key with a value is managed here and WINS: the Config page shows it
#     as "managed by config.txt" and cannot change it.
#   * Lists are comma-separated: 10.0.0.0/8,192.168.1.5
#   * Secrets do NOT go here. Passwords, tokens and the Zabbix sign-in secret stay in
#     deploy/secrets/ (files) or on the Config page (encrypted). Clusters and their
#     credentials stay on the Config page.

# ------------------------------------------------------------------ network & access

# Port on this host that serves ElasticPro (HTTPS).
LISTEN_PORT=443

# Host names (or IP addresses) people use to open ElasticPro. Anything else is refused.
# Empty: any name is accepted.
ALLOWED_DOMAINS=

# Addresses allowed to open the UI (IP or CIDR). Everyone else gets 403.
# Empty: every address may. The Zabbix sign-in and pairing routes are not affected
# (they are controlled by ZABBIX_ALLOWED_SOURCES).
ALLOWED_UI_IPS=

# Addresses taken out of every rate limit (the Zabbix server, an office or VPN range).
RATE_EXEMPT_IPS=

# Proxies whose X-Real-IP the core believes (normally the nginx container's network).
# Set it: without it, source IPs in the activity log can be forged by anyone who reaches
# the core directly.
TRUSTED_PROXIES=

# true only when an authenticating proxy in front of ElasticPro (oauth2-proxy, an IdP,
# nginx basic auth) sets the X-Auth-User header from a VERIFIED identity, and that proxy's
# address is in TRUSTED_PROXIES. The core then signs that name in without a password.
# Empty or false (the default): the header is ignored.
PROXY_AUTH_HEADER=

# The address the Zabbix module uses to reach ElasticPro, e.g. https://elasticpro.example.com
PUBLIC_URL=

# Pages allowed to show ElasticPro in a frame (CSP frame-ancestors). Empty: the paired
# Zabbix frontend only.
FRAME_ANCESTORS=

# ------------------------------------------------------------------ Zabbix

# The Zabbix frontend, e.g. https://zabbix.example.com
ZABBIX_URL=
# The Zabbix API, if not <ZABBIX_URL>/api_jsonrpc.php
ZABBIX_API_URL=
# Addresses allowed to sign people in and to pair (the Zabbix frontend). The core does not
# count their sign-ins against its budget; list them in RATE_EXEMPT_IPS too to lift nginx's
# limit as well. Empty: any address with a valid signature.
ZABBIX_ALLOWED_SOURCES=
# How often clusters are read from Zabbix, in seconds (30-86400).
ZABBIX_SYNC_SECONDS=
# Check the Zabbix API's TLS certificate: true or false.
ZABBIX_VERIFY_TLS=
# The template that marks a Zabbix host as an Elasticsearch cluster.
ZABBIX_CLUSTER_TEMPLATE=
# true: a Zabbix User sees only clusters mapped to their Zabbix user groups.
# false (the default): every Zabbix sign-in reads every cluster.
ZABBIX_SCOPE_USERS_BY_GROUP=
# true: connect Zabbix clusters with ElasticPro's credentials instead of Vault's.
ZABBIX_USE_ELASTICPRO_CREDENTIALS=
# true: create a Zabbix host for every config cluster Zabbix does not have yet.
ZABBIX_CREATE_HOSTS=
# Host group for hosts created that way.
ZABBIX_HOST_GROUP=
# Push ElasticPro's own request figures (the Request Centre's: in flight, queued, wait p95,
# refusals, memory use) to this Zabbix host every 60 s, by history.push over the Zabbix API
# above. The host carries the template "ElasticPro request gate by Zabbix trapper", and the
# API token's user needs read-write permission on it. Empty (the default): nothing is pushed.
ZABBIX_METRICS_HOST=

# ------------------------------------------------------------------ logging

# User activity log (JSON lines for SIEM): a path inside the core, or off.
ACTIVITY_LOG=
ACTIVITY_LOG_MAX_MB=
ACTIVITY_LOG_KEEP=
# true: also write each activity line to the container log (docker compose logs core).
ACTIVITY_LOG_STDOUT=
# Days of notification history kept per person.
NOTIFY_DAYS=
# Core log level: error, warn, info, debug.
LOG_LEVEL=

# ------------------------------------------------------------------ performance

# Seconds between health polls of each cluster (180-300).
POLL_HEALTH_SECONDS=
# Cluster requests the poller runs at once, across the fleet (1-256). Unset: 4 under the
# shipped Client basis request policy, 16 for Automatic and Background. Set, it wins.
POLL_CONCURRENCY=
# Requests to Elasticsearch in flight at once, all sources together (1-1024; default 24).
ES_CONCURRENCY=
# ...to one cluster (default 4), and through one SSH jump host (default 8).
ES_PER_CLUSTER=
ES_PER_JUMP_HOST=
# Of ES_CONCURRENCY, connections only background work (the poller, the delay sink) may
# use, so a burst of page requests can never stop the health poll (default 2).
ES_BACKGROUND_RESERVE=
# Page requests that may wait for a free connection at once, everybody together (default
# 256) and per person (default 64). Past either, a request is refused at once with EP-214
# and a time to retry; the page retries a read once by itself. Background work never is.
ES_QUEUE_MAX=
ES_QUEUE_PER_USER=
# The longest a page request waits for a connection before EP-215 (ms, default 20000).
ES_QUEUE_WAIT_MS=
# No request is given longer than this by a cluster, whatever it asks (ms, default 115000;
# nginx gives up on the core at 120 s).
ES_MAX_TIMEOUT_MS=
# A page's read is answered from memory for this many seconds when someone asked the same
# a moment ago (0 = off; default 5). Reload always asks the cluster; any write to a
# cluster empties what is kept for it.
ES_READ_CACHE_SECONDS=
# Memory for that, MB (default 64; never more than the core's memory budget allows).
ES_READ_CACHE_MB=
# The largest answer a page's request may bring back, MB (default 64; EP-216 past it).
ES_MAX_RESPONSE_MB=
# The same for the poller's fleet-wide datasets, MB (default 256).
ES_MAX_FLEET_RESPONSE_MB=
# Cancel our own searches nobody waits for any more (a page left, a timeout):
# off, orphans (default) or overdue (orphans, plus ours running past ES_TASK_MAX_SECONDS).
# Only read tasks carrying ElasticPro's X-Opaque-Id; never a write, never anyone else's.
ES_TASK_REAPER=
ES_TASK_MAX_SECONDS=
# Zabbix API calls open at once (1-64; default 4).
ZABBIX_CONCURRENCY=
# In-memory cache size, MB. Empty: a quarter of CORE_MEM_LIMIT (512 at the default 2g). The
# core warns at start when a value here cannot fit the limit.
CACHE_MB=
# Housekeeping: one timer that cleans what ElasticPro itself leaves behind (cache files of
# removed clusters and stale ones, Redis keys of removed clusters, ended sessions, expired
# API tokens, rotated logs). Never touches config, saved queries, uploaded keys or users.
# Minutes between runs; 0 turns the timer off (Run now in the Request Centre still works).
# Default 60; the first run is 5 minutes after start.
HOUSEKEEPING_MINUTES=
# Days an on-demand cache file (indices, shards, full snapshot list) may sit untouched before
# it is deleted. Background datasets go after 7 days. Default 2.
HOUSEKEEPING_CACHE_DAYS=
# true: report what would be removed in the core log and the Request Centre, and delete nothing.
HOUSEKEEPING_DRY_RUN=
# Days an ordinary session may sit unused before it ends; 0 (default) = sessions never expire
# and nobody is ever signed out. WARNING: setting this signs people out - anyone who has not
# used ElasticPro for that many days must sign in again. There is no limit on how many
# sessions one account may hold. Zabbix frame sessions, which a reload orphans (the frame
# signs in again on every load), end after 24 hours unused whatever this says; one used
# within the day is never ended.
SESSION_IDLE_DAYS=
# Days a rotated activity log (activity.jsonl.1, .2 ...) is kept; 0 (default) = by size only.
ACTIVITY_LOG_KEEP_DAYS=
# Memory limit of the core container, e.g. 2g or 512m. Empty: 2g.
CORE_MEM_LIMIT=

# ------------------------------------------------------------------ UI defaults
# Apply to every cluster unless a cluster overrides them. Managed here, they are read-only
# in Config → Defaults.

# Clusters are read-only unless a person unlocks writes: true or false.
UI_READ_ONLY=
# Refresh pages by themselves: true or false.
UI_AUTO_REFRESH=
# Seconds between refreshes (5-3600).
UI_REFRESH_SECONDS=
# Elasticsearch request timeout, ms (1000-600000).
UI_REQUEST_TIMEOUT_MS=
# Disk used, percent, that turns yellow / red.
UI_DISK_WARN_PERCENT=
UI_DISK_CRIT_PERCENT=
# Hours after which the last snapshot counts as stale.
UI_SNAPSHOT_STALE_HOURS=
# Index pattern and time field the log pages search.
UI_LOG_INDEX_PATTERN=
UI_TIME_FIELD=
# Certificates: auto, system or insecure (insecure accepts every certificate).
UI_TLS=
# How data that arrives is drawn: pending (the default) holds it while you are using the
# page and draws it a few seconds after you pause; live repaints as it lands; manual draws
# only on Refresh or when you open another page.
UI_LIVE_REDRAW=
# What the app opens on: last-selected or all.
UI_DEFAULT_SCOPE=
# Rows per table page, and most log lines shown.
UI_ROWS_PER_PAGE=
UI_MAX_LOG_ROWS=

# Index volume per day / per month (Indices > Summary; docs/VOLUME.md). Each key set here
# locks its row in the volume settings for every cluster. Field lists are comma-separated
# names tried left to right; the first one the mapping knows wins (a text field uses its
# .keyword).
# Which indices count: * is the source, YYYY.MM.DD the day. Default logstash-*-YYYY.MM.DD.
UI_VOLUME_INDEX_FORMAT=
# Breakdown fields. Defaults: tag1, labels.tag1, tags / fwd_tag, fwdtag, observer.name /
# src_hostname, host.name / src_ip, source.ip, host.ip.
UI_VOLUME_TAG_FIELDS=
UI_VOLUME_FORWARDER_FIELDS=
UI_VOLUME_HOST_FIELDS=
UI_VOLUME_IP_FIELDS=
# Numeric fields summed per day (shipper byte counts). Defaults: event_logsize / sub_size.
UI_VOLUME_EVENT_SIZE_FIELD=
UI_VOLUME_SUB_SIZE_FIELD=
# One more breakdown, named as you like. Defaults: Dataset / event.dataset, log_type.
UI_VOLUME_EXTRA_NAME=
UI_VOLUME_EXTRA_FIELDS=
# What the graph and cards plot: primary, total (with replicas) or eventSize.
UI_VOLUME_SIZE_BASIS=
# Values kept per field per day (5-100), and months the record keeps (1-36).
UI_VOLUME_TOP_VALUES=
UI_VOLUME_KEEP_MONTHS=
# When the daily collection runs, HH:MM in the server's local time. That is the TZ of the
# core container: set TZ in deploy/.env (an IANA name such as Asia/Kolkata, or a POSIX
# string such as IST-5:30); unset is UTC. Default 06:00.
UI_VOLUME_COLLECT_AT=
